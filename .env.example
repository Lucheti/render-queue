# Copy to .env for `pnpm dev`. The values match the infrastructure started by docker compose.
# Start it with: docker compose up -d postgres redis minio minio-init

LOG_LEVEL=debug

DATABASE_URL=postgres://render:render@localhost:5432/render
REDIS_URL=redis://localhost:6379

S3_BUCKET=render-queue
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

API_KEY=dev-api-key-change-me-0123456789
PORT=3000
CORS_ORIGINS=http://localhost:5173

WORKER_CONCURRENCY=2
WORK_DIR=/tmp
