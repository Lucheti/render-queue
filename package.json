{
  "name": "render-queue",
  "version": "1.0.0",
  "description": "Media upload and render-job API: presigned S3 uploads, BullMQ workers and SSE progress, shipped as containers for ECS Fargate.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.1.0",
  "scripts": {
    "dev": "pnpm db:migrate && concurrently -k -n api,worker -c blue,magenta \"pnpm dev:api\" \"pnpm dev:worker\"",
    "dev:api": "tsx watch --env-file-if-exists=.env src/main-api.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/main-worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:api": "node dist/main-api.js",
    "start:worker": "node dist/main-worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "INTEGRATION=1 vitest run --project integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "gate": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1170.0",
    "@aws-sdk/lib-storage": "^3.1170.0",
    "@aws-sdk/s3-request-presigner": "^3.1170.0",
    "@fastify/cors": "^11.4.3",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.4",
    "bullmq": "^6.7.7",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
